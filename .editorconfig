# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
# Make requires a literal tab before every recipe line and fails with
# "missing separator" on spaces. Without this block the global space rule
# above silently breaks the file the moment an editor reformats it.
indent_style = tab

[*.md]
# Trailing whitespace is a hard line break in Markdown.
trim_trailing_whitespace = false
