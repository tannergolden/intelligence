# =============================================================================
# commit-msg - the ONLY commit message enforcement this repository has
# =============================================================================
# WHY A LOCAL HOOK AND NOT A WORKFLOW. Every commit-message gate in this
# ecosystem is pull-request shaped: the shared commit checker reads
# `PR_NUMBER` from the environment and calls `/pulls/{n}/commits`, and the
# ruleset feature that would substitute for it (Metadata restrictions) is
# Enterprise-plan only, on an account that is a User. This repository takes
# direct pushes and opens no pull requests, so there is no pull request for
# any of that to hang off. A message that lands here has been checked by
# this file or by nothing at all.
#
# That also means the em dash prohibition is NOT machine-enforced on the
# server side, whatever any inherited documentation says. It is enforced
# here, on the machine that writes the commit, before the message exists.
#
# INSTALL, once per clone:
#
#     git config core.hooksPath .githooks
#
# GIT SILENTLY SKIPS A HOOK THAT IS NOT EXECUTABLE. No warning, no exit
# code, no log: the commit simply succeeds unchecked. If this file arrived
# without its executable bit (a plain copy, an archive, or a transport that
# cannot express file modes), run `chmod +x .githooks/commit-msg`. Nothing
# below relies on the bit, so it also runs by hand:
#
#     sh .githooks/commit-msg .git/COMMIT_EDITMSG
#
# THE RULES:
#   format        <type>(<scope>)!?: <subject>, scope REQUIRED
#   header-length header at most 100 characters
#   body-length   every body line at most 78 characters
#   em-dash       no em dash anywhere in the message
#
# The scope is required even though Conventional Commits makes it optional.
# Without one the log reads `docs: add the seed` a hundred times over and
# answers "where?" nowhere.
#
# All violations are reported at once. A hook that stops at the first one
# turns a single reword into three.
# =============================================================================
set -u

MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  echo "commit-msg: no commit message file given (usage: commit-msg <path>)." >&2
  exit 1
fi

MAX_HEADER=100
MAX_BODY=78
TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|security|revert'

# The banned characters, built from their code points so that this file
# never contains one itself. U+2014 EM DASH is the rule; U+2013 EN DASH and
# U+2015 HORIZONTAL BAR are caught with it because none of the three belongs
# in a commit message and three literals are harder to get wrong than one
# byte range, which would also match the leading byte of every emoji.
EM_DASH="$(printf '\342\200\224')"
EN_DASH="$(printf '\342\200\223')"
HORIZONTAL_BAR="$(printf '\342\200\225')"

problems=''
note() {
  problems="${problems}  - ${1}
"
}

# Read the message, dropping git's comment lines and everything below the
# `# ----- >8 -----` scissors, which is the diff `git commit -v` appends.
# Neither is part of the message, and the diff routinely contains characters
# the rules below would reject.
header=''
message=''
line_number=0
long_body_lines=''

while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    '#'*'>8'*) break ;;
    '#'*) continue ;;
  esac

  # Skip blank lines before the header; a message that opens with one is
  # still a message whose first real line is the header.
  if [ -z "$header" ] && [ -z "$line" ]; then
    continue
  fi

  line_number=$((line_number + 1))

  if [ "$line_number" -eq 1 ]; then
    header="$line"
    message="$line"
    continue
  fi

  message="${message}
${line}"

  # ${#line} counts bytes in some POSIX shells and characters in others.
  # The difference only ever makes this stricter on a line carrying
  # multibyte characters, which is the safe direction for a length cap.
  if [ "${#line}" -gt "$MAX_BODY" ]; then
    long_body_lines="${long_body_lines} ${line_number}"
  fi
done < "$MSG_FILE"

if [ -z "$header" ]; then
  echo "commit-msg: the commit message is empty." >&2
  exit 1
fi

# Mechanical messages git writes for itself. `revert` is deliberately NOT
# exempt: it is an allowed type, so a revert gets reworded as
# `revert(<scope>): ...` like everything else.
case "$header" in
  'Merge '*|'fixup! '*|'squash! '*|'amend! '*)
    exit 0
    ;;
esac

if [ "${#header}" -gt "$MAX_HEADER" ]; then
  note "[header-length] the header is ${#header} characters (limit ${MAX_HEADER})"
fi

if ! printf '%s\n' "$header" | grep -Eq "^(${TYPES})\([a-z0-9][a-z0-9-]*\)!?: .+"; then
  if printf '%s\n' "$header" | grep -Eq "^(${TYPES})!?: "; then
    note "[format] the type has no scope, write \`<type>(<scope>): <subject>\` where the scope names the area changed (payload, sync, workflows, docs, deps)"
  else
    note "[format] the header does not match \`<type>(<scope>): <subject>\`"
  fi
fi

if [ -n "$long_body_lines" ]; then
  for n in $long_body_lines; do
    note "[body-length] body line ${n} is longer than ${MAX_BODY} characters"
  done
fi

case "$message" in
  *"$EM_DASH"*|*"$EN_DASH"*|*"$HORIZONTAL_BAR"*)
    note "[em-dash] the message contains an em dash or one of its neighbours; use a comma, a colon, parentheses, or a spaced hyphen"
    ;;
esac

if [ -n "$problems" ]; then
  {
    echo ""
    echo "commit-msg: rejected by .githooks/commit-msg"
    echo ""
    printf '%s' "$problems"
    echo ""
    echo "  header  <type>(<scope>)!?: <subject>, at most ${MAX_HEADER} characters"
    echo "  body    lines at most ${MAX_BODY} characters"
    echo "  types   $(printf '%s' "$TYPES" | tr '|' ' ')"
    echo ""
    echo "The message is kept in ${MSG_FILE}."
    echo "Fix it and commit again, or \`git commit --amend\` for the last commit."
    echo ""
  } >&2
  exit 1
fi

exit 0
