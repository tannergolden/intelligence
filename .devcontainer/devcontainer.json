// Development container for the intelligence hub: the environment's image.
//
// ghcr.io/tannergolden/environment holds git, Python 3.12, Node.js 22 and
// every tool the standards' checks run, at the versions CI installs them at,
// so the hub's own checks - the validator, the renderer's check, the
// installer and kit tests - run here as they run in CI. The image's own label
// makes the container work as `vscode`.
//
// This file is the hub's own: its two lines in .github/template-sync are
// switched off, so a sync never puts the template's container back.
{
  "name": "Intelligence",
  "image": "ghcr.io/tannergolden/environment:1",

  "customizations": {
    "vscode": {
      // The template's essentials, and the hub's own language: its scripts
      // and their tests are Python.
      "extensions": [
        "editorconfig.editorconfig",
        "eamodio.gitlens",
        "yzhang.markdown-all-in-one",
        "davidanson.vscode-markdownlint",
        "tamasfe.even-better-toml",
        "ms-python.python",
        "charliermarsh.ruff"
      ]

      // No "settings" block here on purpose. VS Code reads
      // .vscode/settings.json inside the container like anywhere else, so a
      // copy here would be a second source of truth.
    }
  },

  // What the template's container does when it is created: the scripts'
  // requirements, the git hooks in .github/scripts/hooks, which check a
  // commit message before git records it, and the commit message template.
  // The image already holds gitleaks, at the version CI scans with, which
  // the pre-commit hook uses.
  "postCreateCommand": "python3 -m pip install --user --require-hashes --requirement .github/scripts/requirements.txt && git config core.hooksPath .github/scripts/hooks && git config commit.template .github/commit-template.txt"
}
