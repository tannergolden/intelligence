# Normalize line endings. This matters more here than in most repositories:
# every byte under payload/ is copied verbatim into other people's trees, so
# a CRLF that sneaks in on one machine is a CRLF delivered to all of them,
# and a shell script fetched with CRLF is a script the runner cannot execute.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md   text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
