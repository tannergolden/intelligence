# Normalize line endings. This matters more here than in most repositories:
# the agent files are copied verbatim into other people's trees by the sync,
# and skills are copied by hand into vendor directories, so a CRLF that sneaks
# in on one machine is a CRLF delivered everywhere.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
