# Python bytecode. The only Python here is stdlib-only and runs from source,
# so a stray __pycache__ is always local noise.
__pycache__/
*.py[cod]

# Skill eval output. `evals/evals.json` is authored and committed; the
# grading and benchmark files beside it are run artifacts that record one
# machine's run and would be rewritten by the next.
grading.json
benchmark.json

# Build output. `make build` packages each skill into dist/, and the release
# workflow does the same before attaching the archives to a release. Both are
# rebuilt from source on every run, so a committed copy is a copy that rots.
dist/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
