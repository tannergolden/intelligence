    "Validation":    {"operating_stage": "found",    "playbook": "founding-checklist (customer discovery, MVP)",  "next_milestone": "evidence of real demand before building",  "convene": "CEO + Product + Marketing",                "rigor": "light",               "metrics": "activation, early retention, interviews"},
    "Pre-revenue":   {"operating_stage": "found",    "playbook": "founding-checklist (MVP to first customers)",   "next_milestone": "first paying customers",                   "convene": "CEO + Product + Sales + Finance (runway)", "rigor": "light to standard",   "metrics": "activation, cohort retention, runway"},
    "Early Revenue": {"operating_stage": "found",    "playbook": "founding to scale transition",                  "next_milestone": "signs of product-market fit",              "convene": "CEO + the GTM and Product chiefs",         "rigor": "standard",            "metrics": "retention, NRR signal, CAC payback"},
    "Growth":        {"operating_stage": "scale",    "playbook": "scaling playbook (repeatable motion, hiring)",  "next_milestone": "repeatable, efficient growth",             "convene": "the relevant board; CRO owns the number",  "rigor": "standard to deep",    "metrics": "CAC payback, NRR, burn multiple, growth rate"},
    "Scaling":       {"operating_stage": "scale",    "playbook": "scaling playbook (org design, process)",        "next_milestone": "efficient scale without losing speed",     "convene": "full relevant board + COO execution",      "rigor": "deep",                "metrics": "Rule of 40, magic number, NRR, gross margin"},
    "Established":   {"operating_stage": "maintain", "playbook": "operating-cadence + venture-health-check",      "next_milestone": "defend the core, fund the next S-curve",   "convene": "quarterly board + the chiefs",             "rigor": "standard",            "metrics": "Rule of 40, free cash flow, durable NRR, H2/H3 pipeline"},
    "Mature":        {"operating_stage": "maintain", "playbook": "operating-cadence + anti-aging review",         "next_milestone": "detect aging signals early; reinvest",     "convene": "quarterly board; CSO on horizons",         "rigor": "standard",            "metrics": "FCF and margin, reinvestment in R&D, H2/H3 health"},
    "Plateau":       {"operating_stage": "maintain", "playbook": "strategize (pivot or reinvent) + health-check", "next_milestone": "a funded next S-curve or a deliberate pivot", "convene": "CEO + CSO + the board",                 "rigor": "deep",                "metrics": "growth-stall signals, H2/H3 pipeline"},
    "Decline":       {"operating_stage": "maintain", "playbook": "decide (turnaround or wind-down) with Founder", "next_milestone": "a turnaround plan or an orderly outcome",  "convene": "CEO + CFO + CSO + Founder",                "rigor": "deep",                "metrics": "cash, runway, contribution margin"}
  }
